APP_NAME="Raffle Link Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=raffle
DB_USERNAME=raffle
DB_PASSWORD=change-this-password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Generate one random secret (>= 32 chars) and share it with the Nginx master env.
# Never commit real secrets.
RAFFLE_LINK_SECRET=
RAFFLE_ADMIN_TOKEN=
RAFFLE_LINK_CACHE_TTL=30
RAFFLE_ENTRY_RATE_LIMIT=30
RAFFLE_ADMIN_RATE_LIMIT=120
